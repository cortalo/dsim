net1_num, net2_num, net3_num, net4_num, net5_num, net6_num, net7_num, net8_num, net9_num, net10_num, net11_num, net12_num, net13_num, net14_num, net15_num, net16_num --> add --> net_out
net_in --> scaler(0) --> net_in_dummy
