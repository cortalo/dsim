# elliptic
--- Netlist
net_i, net1b, net2b, net3b, net4b, net5b, net6b --> add --> net0
net0 --> delay(1) --> net1
net1 --> delay(1) --> net2
net2 --> delay(1) --> net3
net3 --> delay(1) --> net4
net4 --> delay(1) --> net5
net5 --> delay(1) --> net6

net1 --> scaler(-b[1]) --> net1b
net2 --> scaler(-b[2]) --> net2b
net3 --> scaler(-b[3]) --> net3b
net4 --> scaler(-b[4]) --> net4b
net5 --> scaler(-b[5]) --> net5b
net6 --> scaler(-b[6]) --> net6b

net0 --> scaler(a[0]) --> net0a
net1 --> scaler(a[1]) --> net1a
net2 --> scaler(a[2]) --> net2a
net3 --> scaler(a[3]) --> net3a
net4 --> scaler(a[4]) --> net4a
net5 --> scaler(a[5]) --> net5a
net6 --> scaler(a[6]) --> net6a

net0a, net1a, net2a, net3a, net4a, net5a, net6a --> add --> net_o

# net_i --> tf([a0, a1, a2, a3, a4, a5, a6],[1, b1, b2, b3, b4, b5, b6],1) --> net_o

lambda n: pow(2,34) --> net_i
