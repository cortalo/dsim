def func(x, num):
    ret = []
    for i in x:
        ret.append(int(i*num)/num)
    return ret

def print_int(x, num, a):
    ret = []
    for i in range(len(x)):
        print('assign {}{} = {};'.format(a,i, int(x[i]*num)))

