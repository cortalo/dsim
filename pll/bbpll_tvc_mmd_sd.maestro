# Figure 3
cur_ax = ax[1]
plot.phase_noise(fig, cur_ax, pll_out_mem[int(len(pll_out_mem)/5*3):], Fout=(25 + frac_num/1024)*Fref, color='C0', label='matlab simulation', integ_to=100e6)
plot.phase_noise(fig, cur_ax, pll_out_mem[int(len(pll_out_mem)/5*3):], Fout=(25 + frac_num/1024)*Fref, sumover_N=50, color='C1', label='matlab simulation', linewidth=2)

# Hdsadc = lambda s: frac(Fref/s*Kbb_eq, 1+0.02*Fref/s*Kbb_eq)
Hdsadc = lambda s: Kbb_eq

Hopen_ref = lambda s: frac(1,2*pi)*frac(1,1+(s/omega_c))*Hdsadc(s)*(Kp*frac(1,1+(s/omega_cc)) + frac(Ki*Fref,s))*frac(2*pi*Kvco,s)
Hclose_dco = lambda s: 1/(1+Hopen_ref(s)/N)
Ldco = lambda f: frac((2*pi*100e6)**2 * pow(10,-16), (2*pi*f)**2)
plot.plot_psd(fig, cur_ax, lambda f: Ldco(f)*plot.tf2psd(Hclose_dco)(f), fstart=1e3, fend=7e9, color='C2', label='DCO output', linewidth=2)
Lbbq = lambda f: (1-(2/pi))/Fref
Hclose_bbq = lambda s: (Kp*frac(1,1+(s/omega_cc)) + frac(Ki*Fref,s))*frac(2*pi*Kvco,s)/(1+Hopen_ref(s)/N)
Hcmp_dsm = lambda s: 1/(1+Fref*50*0.02/s)
plot.plot_psd(fig, cur_ax, lambda f: Lbbq(f)*plot.tf2psd(Hclose_bbq)(f)*plot.tf2psd(Hcmp_dsm)(f), fstart=1e3, fend=7e9, color='C3', label='Comparator Q output', linewidth=2)
Lref_f = lambda f: pow(10, Lref/10)
Hclose_ref = lambda s: Hopen_ref(s)/(1+Hopen_ref(s)/N)
Lref_out = lambda f: Lref_f(f)*plot.tf2psd(Hclose_ref)(f)
plot.plot_psd(fig, cur_ax, Lref_out, fstart=1e3, fend=7e9, color='C4', label='ref output', linewidth=2)

Ldsm = lambda f: frac(pow(2*pi,2), 12*Fref)*pow(2*math.sin(pi*f/Fref), 2*2)
Hclose_dsm = lambda s: (Hopen_ref(s)/N)/(1+(Hopen_ref(s)/N))
plot.plot_psd(fig, cur_ax, lambda f: Ldsm(f)*plot.tf2psd(Hclose_dsm)(f), fstart=1e3, fend=7e9, color='C5', label='Divider Q noise output', linewidth=2)
cur_ax.legend(fontsize=14)



