# bbpll
# vanilla fractional bbpll
# using third order dsm
--- Netlist
n_dco, net9, t_dco --> add --> net1
net1 --> tf([1],[1,-1],1) --> pll_out
n_ref, net10 --> sub --> net4
net4 --> bbpd --> net5
# net4 --> scaler(3.57e13) --> net5
net5 --> scaler(Kp) --> net6
net5 --> tf([Ki, 0],[1,-1],1) --> net7
net6, net7 --> add --> net8
net8 --> scaler(N*KT) --> net9
n_mmd --> tf([1,-1],[1,0],1) --> tf([1,-1],[1,0],1) --> net11
net11, pll_out --> add --> net10
