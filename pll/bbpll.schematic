# bbpll
--- Netlist
lambda n: np.random.randn()*sigma_ref --> n_ref
lambda n: np.random.randn()*sigma_dco --> n_dco
n_ref, fb --> sub --> net1
net1 --> bbpd --> net2
net2 --> scaler(Kp) --> net3
net2 --> tf([Ki, 0],[1,-1],1) --> net4
net3, net4 --> add --> net5
net5 --> up_zoh(N) --> scaler(KT) --> net6
n_dco, net6 --> add --> net7
net7 --> tf([1],[1,-1],1) --> pll_out
pll_out --> down_sampler(N) --> fb
