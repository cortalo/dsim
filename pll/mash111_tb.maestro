--- Plots
from matplotlib.ticker import EngFormatter

Fref = 100e6

fig, ax = plt.subplots(1,2)

# Figure 1
cur_ax = ax[0]
plot.pts(fig, cur_ax,mash_o_mem[int(len(mash_o_mem)/5*0):], Fs=Fref)
formatter = EngFormatter(unit='s')  # You can change 's' to the appropriate unit
cur_ax.set_title('DLF output')
cur_ax.xaxis.set_major_formatter(formatter)

# Figure 2
cur_ax = ax[1]
plot.plot_psd(fig, cur_ax, mash_o_mem, Fs=Fref)

plt.show()
