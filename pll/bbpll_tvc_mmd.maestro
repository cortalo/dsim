--- Test
dsim: /home/longhe/repos/dsim
schematic: bbpll_tvc_mmd
runtime: pll_out
runnum: 200000
saveall: True
seed: 19
--- Parameters

N = 25
Fref = 600e6
Tref = 1/Fref
Fosc = N*Fref
Tosc = 1/Fosc

Lref = -170
sigma_ref = plot.L2jitter(Lref, Fref)
L_dco = -160
sigma_dco = plot.VCO_L2jitter(L_dco, Fosc, 100e6)

Kvco = 200e3
KT = (1/Fosc) - (1/(Fosc+Kvco))
frac_num = 1
Kp = 4
Ki = Kp/100

Kbb_eq = 250

print("Kbb_eq: {}".format(EngNumber(Kbb_eq)))
print("Kp: {}".format(EngNumber(Kp)))
print("Ki: {}".format(EngNumber(Ki)))

omega_c = 2*pi*10e6
var_a = math.exp(-omega_c * Tref)
omega_cb = 2*pi*50e6
var_b = math.exp(-omega_cb * Tref)

omega_cc = 2*pi*10e6
var_c = math.exp(-omega_cc * Tref)


n_dco_mem = []
n_dco = dsim.sig_init(lambda: lambda n: np.random.randn()*sigma_dco*1, n_dco_mem)
n_ref_mem = []
n_ref = dsim.sig_init(lambda: lambda n: np.random.randn()*sigma_ref * 1 + (n+0.5)/Fref, n_ref_mem)
t_dco_mem = []
t_dco = dsim.sig_init(lambda: lambda n: 1/((25+frac_num/1024)*Fref), t_dco_mem)
net13_mem = []
net13 = dsim.sig_init(lambda: lambda n: -0.5, net13_mem)
net17_mem = []
net17 = dsim.sig_init(lambda: lambda n: np.random.randn()*sqrt(1-2/pi) * 0, net17_mem)


ratio_mem = []
ratio = dsim.sig_init(lambda: lambda n: int(25 * 1024 + frac_num) , ratio_mem)
--- Plots
from matplotlib.ticker import EngFormatter

print("comparator input std: {}".format(EngNumber(np.std(net14_mem[int(len(net14_mem)/5):]))))
input_std = np.std(net14_mem[int(len(net14_mem)/5):])
print("equivalent gain: {}".format(EngNumber(sqrt(2/pi)/input_std)))

fig, ax = plt.subplots(1,3)

# Figure 1
cur_ax = ax[0]
plot.pts(fig, cur_ax, net8_mem[int(len(net8_mem)/5):], Fs=Fref)
formatter = EngFormatter(unit='s')  # You can change 's' to the appropriate unit
cur_ax.set_title('DLF output')
cur_ax.xaxis.set_major_formatter(formatter)

# Figure 2
cur_ax = ax[1]
cur_ax.hist(net14_mem[int(len(net14_mem)/5):], bins=200, density=True)
cur_ax.set_title('Comparator Input')

# Figure 3
cur_ax = ax[2]
plot.phase_noise(fig, cur_ax, pll_out_mem[int(len(pll_out_mem)/5):], Fout=(25 + frac_num/1024)*Fref, color='C0', label='simulation', integ_to=100e6)
plot.phase_noise(fig, cur_ax, pll_out_mem[int(len(pll_out_mem)/5):], Fout=(25 + frac_num/1024)*Fref, sumover_N=50, color='C1', label='simulation', linewidth=2)

Hopen_ref = lambda s: frac(1,2*pi)*frac(1,1+(s/omega_c))*Kbb_eq*(Kp*frac(1,1+(s/omega_cc)) + frac(Ki*Fref,s))*frac(2*pi*Kvco,s)
# Hopen_ref = lambda s: frac(1,2*pi)*frac(1,1+(s/omega_c))*Kbb_eq*(Kp + frac(Ki*Fref,s))*frac(2*pi*Kvco,s)
Hclose_dco = lambda s: 1/(1+Hopen_ref(s)/N)
Ldco = lambda f: frac((2*pi*100e6)**2 * pow(10,-16), (2*pi*f)**2)
Ldco_out = lambda f: Ldco(f)*plot.tf2psd(Hclose_dco)(f)
plot.plot_psd(fig, cur_ax, Ldco_out, fstart=1e3, fend=7e9, color='C2', label='DCO output', linewidth=2)
Lbbq = lambda f: (1-(2/pi))/Fref
Hclose_bbq = lambda s: (Kp*frac(1,1+(s/omega_cc)) + frac(Ki*Fref,s))*frac(2*pi*Kvco,s)/(1+Hopen_ref(s)/N)
Lbbq_out = lambda f: Lbbq(f)*plot.tf2psd(Hclose_bbq)(f)
plot.plot_psd(fig, cur_ax, Lbbq_out, fstart=1e3, fend=7e9, color='C3', label='BB Q output', linewidth=2)
Lref_f = lambda f: pow(10, Lref/10)
Hclose_ref = lambda s: Hopen_ref(s)/(1+Hopen_ref(s)/N)
Lref_out = lambda f: Lref_f(f)*plot.tf2psd(Hclose_ref)(f)
plot.plot_psd(fig, cur_ax, Lref_out, fstart=1e3, fend=7e9, color='C4', label='ref output', linewidth=2)


Ldsm = lambda f: frac(pow(2*pi,2), 12*Fref)*pow(2*math.sin(pi*f/Fref), 2*2)
Hclose_dsm = lambda s: (Hopen_ref(s)/N)/(1+(Hopen_ref(s)/N))
plot.plot_psd(fig, cur_ax, lambda f: Ldsm(f)*plot.tf2psd(Hclose_dsm)(f), fstart=1e3, fend=7e9, color='C5', label='Divider Q output', linewidth=2)
cur_ax.legend(fontsize=12)

