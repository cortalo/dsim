--- Test
dsim: /home/longhe/repos/dsim
schematic: bbpll
runtime: pll_out
runnum: 100000
saveall: True
seed: 13
--- Parameters
N = 1
Fref = 10e6
Tref = 1/Fref
Fosc = N*Fref
Tosc = 1/Fosc
sigma_ref = 1e-12
sigma_dco = 100e-12
KT = 10e-12
Kp = 10
Ki = 0.1

--- Plots

eta = sqrt(pi/2)*(frac(sigma_dco**2, 2*Kp*KT) + frac(N*Kp*KT,2))
sigma_delta_t = (eta/2) + sqrt((eta/2)**2 + sigma_ref**2)
Kbpd = sqrt(2/pi) / sigma_delta_t
sigma_out = sqrt(sigma_delta_t**2 - sigma_ref**2)
print("expected output jitter: {}".format(EngNumber(sigma_out)))

Hdlf = lambda z: Kp + frac(Ki,1-(1/z))
Hloop = lambda z: Kbpd * Hdlf(z) * N * KT * frac(1,z-1)

from matplotlib.ticker import EngFormatter
fig, ax = plt.subplots(1,1)
plot.phase_noise(fig, ax, pll_out_mem[20000:], Fout=Fref, only_noise=True, color='C0')
plot.phase_noise(fig, ax, pll_out_mem[20000:], Fout=Fref, only_noise=True, sumover_N=50, color='C1')

fig, ax = plt.subplots(2,1)
plot.bode(fig, ax, Hloop, enable_z=True, fsample=Fref, fstart=1e3, fend=Fref/2)
plt.show()
